generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// Durum: "Aktif" | "Bekleyen" | "Pasif"
model Student {
  id         String   @id @default(cuid())
  name       String
  status     String   @default("Aktif")
  age        Int?
  grade      String?
  startDate  String?
  lessonDay  String?
  lessonTime String?
  groupId    String?
  group      Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  birthday   String?
  parentName  String?
  parentPhone String?
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  installments   Installment[]
  studentCourses StudentCourse[]

  @@index([status])
  @@index([groupId])
}

// Öğrenci grupları: aynı gruptaki öğrenciler haftalık programda birlikte ders alır
model Group {
  id        String   @id @default(cuid())
  name      String   @unique
  note      String?
  createdAt DateTime @default(now())

  students Student[]
  sessions ScheduleSession[]
}

// Kur/kurs kataloğu: her kur bir renk + ikonla temsil edilir
model Course {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#502e9f")
  icon      String   @default("BookOpen")
  createdAt DateTime @default(now())

  enrollments StudentCourse[]
  sessions    ScheduleSession[]
}

// Bir öğrencinin aldığı/tamamladığı kurlar, sıralı (en son eklenen sonda)
// status: "Aktif" | "Tamamlandi"
model StudentCourse {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status    String   @default("Tamamlandi")
  createdAt DateTime @default(now())

  @@index([studentId])
  @@index([courseId])
}

// Durum: "Odendi" | "Bekliyor" | "Odenmedi"
model Installment {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  index     Int // 1. Kur, 2. Kur, ...
  amount    Float
  status    String   @default("Bekliyor")
  note      String?
  paidDate  String? // YYYY-MM-DD — ödemenin yapıldığı tarih
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
}

model ScheduleSession {
  id          String   @id @default(cuid())
  date        String // YYYY-MM-DD — bu dersin gerçekleştiği (veya tekrar başlangıcı) tarih
  day         String // Pazartesi..Pazar — date'den türetilir
  time        String // "14:00"
  recurring   Boolean  @default(false) // true: her hafta bu günde tekrarlar, false: sadece bu tarihte
  title       String // örn. öğrenci/grup adları
  note        String?
  groupId     String?
  group       Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  courseId    String?
  course      Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  teacherId   String?
  teacher     Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  durationHrs Float    @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons Lesson[]

  @@index([day])
  @@index([date])
  @@index([teacherId])
  @@index([groupId])
  @@index([courseId])
}

// type: "Normal" | "OkulOncesi"
// durum: "Ulasilamadi" | "TakipAramasi" | "Olumsuz" | "Olumlu"
model Lead {
  id                String   @id @default(cuid())
  type              String   @default("Normal")
  contactName       String?
  phone             String?
  status            String   @default("TakipAramasi")
  studentName       String?
  age               Int?
  grade             String?
  school             String?
  location          String?
  firstContactDate  String?
  lastContactDate   String?
  appointmentDate   String?
  appointmentTime   String?
  note              String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([type])
  @@index([status])
}

// rateType: "PerLesson" | "PerHour"
model Teacher {
  id       String  @id @default(cuid())
  name     String
  phone    String?
  rateType String  @default("PerLesson")
  rate     Float   @default(0)
  note     String?

  lessons          Lesson[]
  scheduleSessions ScheduleSession[]
}

model Lesson {
  id                String           @id @default(cuid())
  teacherId         String
  teacher           Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  scheduleSessionId String?
  scheduleSession   ScheduleSession? @relation(fields: [scheduleSessionId], references: [id], onDelete: SetNull)
  date              String // YYYY-MM-DD
  day               String?
  time              String?
  groupLabel        String? // öğrenci/grup adı
  course            String?
  durationHrs       Float            @default(1)
  fee               Float // hesaplanan / manuel ücret
  paid              Boolean          @default(false)
  paidDate          String?
  note              String?
  createdAt         DateTime         @default(now())

  @@index([teacherId])
  @@index([paid])
  @@index([scheduleSessionId])
}
