# Prod'da Vercel Postgres (Neon) eklendiğinde bu ikisi otomatik doldurulur.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# Giriş oturumlarını imzalamak için rastgele, güçlü bir değer — `openssl rand -base64 32` ile üretilebilir.
AUTH_SECRET=""
